const mongoose =  require('mongoose');


const registerSchema  = new mongoose.Schema({

    email:{

        type:String,

        required:true

    },

    password:{

        type:String,

        required:true

    },

    phoneNumber:{

        type:String,

        required:true



    },



    username:{

        type:String,

        required:true

    }

},{timestamps:true});



module.exports = mongoose.model('register',registerSchema);
